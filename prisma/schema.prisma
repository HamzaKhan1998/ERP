generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum DocumentLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

enum DocumentStatus {
  DRAFT
  DOCUMENT_CONTROL_REVIEW
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  RETURNED_FOR_CORRECTION
  SUPERSEDED
  RETIRED
}

enum DocumentVersionStatus {
  CURRENT
  DRAFT
  APPROVED
  SUPERSEDED
}

enum WorkflowAssignmentType {
  PREPARED_BY
  REVIEWED_BY
  APPROVED_BY
}

enum ApprovalDecisionType {
  APPROVED
  RETURNED_FOR_CORRECTION
}

enum ChangeRequestStatus {
  SUBMITTED
  ACCEPTED_FOR_CHANGE
  REJECTED
  INCORPORATED
}

enum PeriodicReviewOutcome {
  REMAINS_VALID
  REVISION_REQUIRED
  RETIRED
  RETURNED_FOR_CLARIFICATION
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
  FILE
}

enum FormVersionStatus {
  DRAFT
  APPROVED
  CURRENT
  SUPERSEDED
  RETIRED
}

enum NotificationType {
  DOCUMENT_RELEASE
  TRAINING_ASSIGNED
  CHANGE_REQUEST
  PERIODIC_REVIEW
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum TrainingTaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum FileAssetUploadStatus {
  PENDING_SCAN
  ACTIVE
  QUARANTINED
  REJECTED
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  subdomain   String       @unique
  status      TenantStatus @default(ONBOARDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  documents   Document[]
  changeRequests ChangeRequest[]
  periodicReviews PeriodicReview[]
  files          FileAsset[]
  formTemplates  FormTemplate[]
  qualityRecords QualityRecord[]
  notifications Notification[]
  trainingTasks TrainingTask[]
  auditLogs     AuditLog[]
}

model User {
  id             String               @id @default(uuid())
  tenantId       String?
  email          String               @unique
  name           String
  passwordHash   String?
  designation    String?
  systemRole     String               @default("MEMBER")
  isPlatformAdmin Boolean              @default(false)
  isTenantAdmin  Boolean              @default(false)
  status         UserStatus           @default(INVITED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignments    WorkflowAssignment[]
  approvals      ApprovalDecision[]
  changeRequestsInitiated ChangeRequest[] @relation("ChangeRequestInitiator")
  changeRequestsReviewed ChangeRequest[] @relation("ChangeRequestReviewer")
  periodicReviews      PeriodicReview[]
  uploadedFiles        FileAsset[]
  qualityRecords       QualityRecord[]
  notifications        Notification[]
  assignedTrainingTasks TrainingTask[]
  formVersionApprovals FormVersionApproval[] @relation("FormVersionApproval")
  auditLogs             AuditLog[]
}

model Document {
  id                 String             @id @default(uuid())
  tenantId           String
  title              String
  controlNumber      String
  level              DocumentLevel
  status             DocumentStatus     @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions           DocumentVersion[]
  changeRequests     ChangeRequest[]
  relatedFrom        DocumentRelation[] @relation("DocumentRelationFrom")
  relatedTo          DocumentRelation[] @relation("DocumentRelationTo")
  files              FileAsset[]
  formTemplates      FormTemplate[]
  qualityRecords     QualityRecord[]
  notifications      Notification[]
  trainingTasks      TrainingTask[]

  @@unique([tenantId, controlNumber])
  @@index([tenantId, status])
  @@index([tenantId, level])
}

model DocumentVersion {
  id                  String               @id @default(uuid())
  documentId          String
  versionLabel        String
  revisionNumber      Int
  status              DocumentVersionStatus @default(CURRENT)
  effectiveDate       DateTime?
  nextReviewDate      DateTime?
  reviewIntervalYears Int                  @default(3)
  purpose             String?
  scope               String?
  responsibilities    String?
  procedureContent    String?
  recordsDescription  String?
  relatedDocuments    String?
  complianceNote      String?
  createdAt           DateTime             @default(now())
  document            Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignments         WorkflowAssignment[]
  approvals           ApprovalDecision[]
  complianceRefs      ComplianceReference[]
  revisionHistory     RevisionHistory[]
  changeRequests      ChangeRequest[]
  incorporatedChangeRequests ChangeRequest[] @relation("ChangeRequestIncorporatedVersion")
  periodicReviews      PeriodicReview[]
  files               FileAsset[]
  qualityRecords      QualityRecord[]
  notifications       Notification[]
  trainingTasks       TrainingTask[]

  @@unique([documentId, revisionNumber])
  @@index([documentId, effectiveDate])
}

model WorkflowAssignment {
  id             String                 @id @default(uuid())
  versionId      String
  userId         String
  type           WorkflowAssignmentType
  assignedAt     DateTime               @default(now())
  completedAt    DateTime?
  version        DocumentVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([versionId, type])
  @@index([userId, type])
}

model ApprovalDecision {
  id          String               @id @default(uuid())
  versionId   String
  userId      String
  decision    ApprovalDecisionType
  comment     String?
  decidedAt   DateTime             @default(now())
  version     DocumentVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([versionId, decidedAt])
  @@index([userId, decision])
}

model ComplianceReference {
  id          String          @id @default(uuid())
  versionId   String
  standard    String
  edition     String?
  clause      String
  description String?
  version     DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model RevisionHistory {
  id                 String          @id @default(uuid())
  versionId          String
  pageNumber         String?
  revisionNumber     String
  changeDescription  String
  createdAt          DateTime        @default(now())
  version            DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model DocumentRelation {
  id               String   @id @default(uuid())
  fromDocumentId   String
  toDocumentId     String
  relationLabel    String?
  fromDocument     Document @relation("DocumentRelationFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument       Document @relation("DocumentRelationTo", fields: [toDocumentId], references: [id], onDelete: Cascade)

  @@unique([fromDocumentId, toDocumentId])
  @@index([toDocumentId])
}

model ChangeRequest {
  id                    String             @id @default(uuid())
  tenantId              String
  documentId            String
  sourceVersionId       String
  incorporatedVersionId String?
    incorporatedVersion   DocumentVersion?    @relation("ChangeRequestIncorporatedVersion", fields: [incorporatedVersionId], references: [id], onDelete: SetNull)
  requestedById         String
  reviewedById          String?
  status                ChangeRequestStatus @default(SUBMITTED)
  existingRequirement   String
  proposedChange        String
  reason                String
  managementComment     String?
  createdAt             DateTime           @default(now())
  reviewedAt            DateTime?
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document              Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceVersion         DocumentVersion    @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  requestedBy           User               @relation("ChangeRequestInitiator", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy            User?              @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([documentId, createdAt])
  @@index([requestedById])
}

model PeriodicReview {
  id                String              @id @default(uuid())
  tenantId          String
  versionId         String
  reviewedById      String
  outcome           PeriodicReviewOutcome
  comments          String?
  referencesChecked String?
  reviewedAt        DateTime            @default(now())
  nextReviewDate    DateTime?
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version           DocumentVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewedBy        User                @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([tenantId, reviewedAt])
  @@index([versionId, reviewedAt])
}

model FileAsset {
  id           String           @id @default(uuid())
  tenantId     String
  documentId   String?
  versionId    String?
  qualityRecordId String?
  uploadedById String
  originalName String
  storageKey   String           @unique
  mimeType     String
  sizeBytes    Int
  checksum     String
  sha256       String
  uploadStatus FileAssetUploadStatus @default(PENDING_SCAN)
  retentionClass String         @default("DEFAULT")
  retentionUntil DateTime?
  legalHold    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  qualityRecord QualityRecord?  @relation(fields: [qualityRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, uploadStatus, createdAt])
  @@index([retentionUntil])
  @@index([documentId])
  @@index([versionId])
  @@index([qualityRecordId])
}

model FormTemplate {
  id             String          @id @default(uuid())
  tenantId       String
  documentId     String?
  title          String
  controlNumber  String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  versions       FormVersion[]
  qualityRecords QualityRecord[]

  @@unique([tenantId, controlNumber])
  @@index([tenantId, createdAt])
}

model FormVersion {
  id                  String              @id @default(uuid())
  templateId          String
  revisionNumber      Int
  status              FormVersionStatus   @default(DRAFT)
  effectiveDate       DateTime?
  nextReviewDate      DateTime?
  reviewIntervalYears Int                 @default(3)
  createdAt           DateTime            @default(now())
  template            FormTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields              FormField[]
  approvals           FormVersionApproval[]
  qualityRecords      QualityRecord[]

  @@unique([templateId, revisionNumber])
  @@index([templateId, status])
}

model FormField {
  id          String        @id @default(uuid())
  versionId   String
  fieldKey    String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  optionsJson Json?
  sortOrder   Int           @default(0)
  version     FormVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, fieldKey])
  @@index([versionId, sortOrder])
}

model FormVersionApproval {
  id         String        @id @default(uuid())
  versionId  String
  reviewedById String?
  decision   String?
  comment    String?
  decidedAt  DateTime?
  version    FormVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("FormVersionApproval", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([versionId])
  @@index([reviewedById])
}

model QualityRecord {
  id             String       @id @default(uuid())
  tenantId       String
  templateId     String
  formVersionId  String?
  documentId     String?
  versionId      String?
  completedById  String
  status         String       @default("SUBMITTED")
  values         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  formVersion    FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version        DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  completedBy    User         @relation(fields: [completedById], references: [id], onDelete: Restrict)
  attachments    FileAsset[]

  @@index([tenantId, createdAt])
  @@index([templateId, createdAt])
  @@index([formVersionId, createdAt])
}

model Notification {
  id          String             @id @default(uuid())
  tenantId    String
  userId      String
  documentId  String?
  versionId   String?
  type        NotificationType
  status      NotificationStatus @default(QUEUED)
  subject     String
  message     String
  queuedAt    DateTime           @default(now())
  sentAt      DateTime?
  readAt      DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version     DocumentVersion?   @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@index([documentId, queuedAt])
}

model TrainingTask {
  id             String             @id @default(uuid())
  tenantId       String
  documentId     String
  versionId      String
  assignedToId   String
  title          String
  dueDate        DateTime?
  status         TrainingTaskStatus @default(ASSIGNED)
  completedAt    DateTime?
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document       Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        DocumentVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  assignedTo     User               @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  @@unique([versionId, assignedToId])
  @@index([tenantId, assignedToId, status])
  @@index([documentId, versionId])
}

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String?
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
